{
  "name": "nexalayer-agent",
  "version": "1.0.0",
  "description": "NexaLayer Model Context Protocol (MCP) server and backend API for managed proxy sessions",
  "main": "dist/index.js",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "proxy"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:safe": "vitest run --config vitest.config.safe-smoke.ts",
    "test:phase0": "node scripts/phase0-smoke.mjs",
    "test:phase0:real": "PHASE0_ALLOW_PAID=1 node scripts/phase0-smoke.mjs",
    "test:phase0:static": "PHASE0_ALLOW_PAID=1 PHASE0_SESSION_TYPE=static PHASE0_STATIC_ZT_ONLY=1 PHASE0_TOPUP_CNY=40 node scripts/phase0-smoke.mjs",
    "trial:calibrate": "node scripts/calibrate-trial-credit.mjs",
    "test:smoke": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "node-cache": "^5.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.12.0",
    "undici": "^7.30.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.20.0",
    "pg": "^8.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
