# === Service ===
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/agent_db

# === JWT ===
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=3600

# === Backend Proxy System ===
BACKEND_BASE_URL=http://surprising-rejoicing.railway.internal:8000
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=admin_password
PRICING_AGENT_APP_ID=139
PRICING_OWNER_AGENT_ID=1474
NEXALAYER_DYNAMIC_PRICE_CNY=1.5
PRODUCT_CACHE_TTL_SECONDS=60

# === Encryption (AES-256-GCM) ===
ENCRYPTION_KEY=change-me-to-a-random-hex-string-64-chars

# === Rate Limit ===
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_DAY=10000

# === Trial ===
TRIAL_BALANCE=5.00
TRIAL_DURATION_DAYS=30

# Owner/ops alerts (fall back to TRIAL_ALERT_* when unset)
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_DEDUPE_MINUTES=30
# Bearer token for /v1/admin/* (min 32 chars). Admin routes are disabled when empty.
OPS_ADMIN_TOKEN=
SUPPORT_EMAIL=support@nexalayer.net
SUPPORT_TELEGRAM=@LEWISMIN
