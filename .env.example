# === Service ===
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/agent_db

# === JWT ===
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=3600

# === Backend Proxy System ===
BACKEND_BASE_URL=http://surprising-rejoicing.railway.internal:8000
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=admin_password

# === Encryption (AES-256-GCM) ===
ENCRYPTION_KEY=change-me-to-a-random-hex-string-64-chars

# === Rate Limit ===
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_DAY=10000

# === Trial ===
TRIAL_BALANCE=5.00
TRIAL_DURATION_DAYS=30
