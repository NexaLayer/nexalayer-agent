{
  "name": "@nexalayer/mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol (MCP) server for NexaLayer managed proxy sessions",
  "mcpName": "io.github.NexaLayer/nexalayer",
  "type": "module",
  "bin": {
    "nexalayer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "mcpb:build": "npm run build && node scripts/build-mcpb.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/credentials.integration.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexaLayer/nexalayer-agent.git",
    "directory": "mcp"
  },
  "homepage": "https://docs.nexalayer.net/en/agents",
  "bugs": "https://github.com/NexaLayer/nexalayer-agent/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "proxy",
    "playwright",
    "browser-automation"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
